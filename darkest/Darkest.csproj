<Project Sdk="Godot.NET.Sdk/4.6.1">

  <!--
    M0 (T-M0-01) 冒烟核对结论 —— 条件编译 / 构建上下文事实（要点4；出处见各条）：
    * csproj 形状对齐 Godot 4.6 (.NET) 编辑器生成物：Sdk=Godot.NET.Sdk/4.6.1 + TargetFramework
      net8.0 + EnableDynamicLoading + RootNamespace=Darkest（程序集名与 project.godot
      dotnet/project/assembly_name="Darkest" 一致）。出处：~/.nuget/packages/godotsharp/4.6.1
      （lib/net8.0）与 godot.net.sdk/4.6.1（Sdk.props）。
    * 本开发机（2026-09-09）仅安装 .NET SDK 10.0.400，无 .NET 8 SDK/运行时，且 NuGet 源不可达
      （离线）。故本机冒烟一律以 `-p:DarkestTargetFramework=net10.0` 覆盖构建/测试（net10 工程可消费
      net8 库 GodotSharp）；正式 CI / 装有 .NET 8 SDK 的编辑器机器按默认 net8.0 构建。
      出处：本机 dotnet SDK 枚举命令输出 + net8 空工程恢复 NU1301 探针。
    * 符号集：Godot.NET.Sdk 提供 GODOT / GODOT_<PLATFORM> 条件编译宏（Sdk.props），GodotSharp
      / GodotSharpEditor(Debug) 为隐式 PackageReference（Sdk.targets）。M0 起 core/sim/data 内
      零 `using Godot`，Godot 引用控制靠"目录白名单静态检查"（仓库根 tools/check_godot_refs.py，
      blueprint §3/§10/§12 风险 8 缓解），而非程序集隔离。
    * 首个 csproj/sln 应由 Godot 4.6 (.NET) 编辑器生成；本机无编辑器可执行文件，故按编辑器生成
      形状手写（见 m0_bootstrap.md §5 冒烟记录），编辑器打开后如与本文件有出入以编辑器实况为准。
    * TFM 通过自定义属性 DarkestTargetFramework 间接取值（默认 net8.0）：NuGet restore 不接受
      `-p:TargetFramework`（单数）全局覆盖，用自定义属性覆盖可同时作用于 restore 与编译。
      本机验证：`dotnet build -p:DarkestTargetFramework=net10.0`。
    * ⚠️ 维护纪律（2026-09-09 编辑器冒烟钉死）：Godot 4.6 C# 插件保存 csproj 时会把下行
      `TargetFramework` 的间接取值【实化为字面量 net8.0】（并生成 *.csproj.old 备份）。
      一旦被实化，本机 net10 覆盖即失效 → 请还原下行并删除 .old；工程默认与 CI 不受影响。
  -->
  <PropertyGroup>
    <DarkestTargetFramework Condition="'$(DarkestTargetFramework)' == ''">net8.0</DarkestTargetFramework>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Darkest</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- T-M0-01 要点3：测试源码（tests/**）不得混入游戏程序集 -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <!-- 冒烟发现（2026-09-09）：SDK 生成物位于 .godot/mono/temp/obj 下，默认编译通配会重复纳入
         （CS0579 特性重复），显式剔除，保证 .godot 内生成 .cs 永不进编译清单 -->
    <Compile Remove=".godot/**/*.cs" />
  </ItemGroup>

</Project>
