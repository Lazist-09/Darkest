; 🔴 2026-10-02（压占位修复）：任务列表随任务数变高（15 行实测 y 204..1023）⇒ 压到左下角 5 个屏幕级占位
;   （QsWaveHighscoreTt 盒顶 648 ／ QsDungeonXpBar 810 ／ 热区 875 ／ 城镇事件 940 ／ 扎营 1004 ⇒ 实测 5 对重叠）。
;   修法 = Godot 内建 `ScrollContainer` 定高：**滚动轴的最小尺寸不向上传播**（4.6 实测，同 HamletRoot.NavScroll 口径）⇒
;   BodyRow 不再被内容撑高。高度 442 = QsWaveHighscoreTt 盒顶 648 − BodyRow 顶 204（实测）− 2px 缝 ⇒ 与下方占位不相交；
;   超出部分玩家滚动可见（DD 的 quest 列表本就可滚）⇒ 信息零丢失 ✓ 范式同 provision_skeleton 的 StoreScroll ✓
;   ⚠️ 442 是**读数常量**：QsWaveHighscoreTt 的 anchor_top（0.6×1080 = 648）一变就要同步重测；护栏 = LayoutAudit 重叠判据 ✓
[node name="QuestListScroll" type="ScrollContainer" parent="QuestSelectCol/BodyRow"]
layout_mode = 2
custom_minimum_size = Vector2(220, 442)
size_flags_vertical = 0   ; 🔴 SIZE_SHRINK_BEGIN（同 hamlet_skeleton 的 EstateCost 姿势）：只拿最小高、贴顶 ⇒ 不随 BodyRow 撑到屏底（否则仍压占位）✓
horizontal_scroll_mode = 0   ; Disabled：宽度照 DD 列宽 220 定死（同 NavScroll 口径）✓
vertical_scroll_mode = 1   ; Auto：装不下才出滚动条（DD 列表行为）✓
tooltip_text = "任务列表（超出即可滚动）· 住在 ScrollContainer 之内 ⇒ 相机「内容需求」判据按 InsideScroll 豁免 ✓"

