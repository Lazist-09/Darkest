anchor_top = 0.1130   ; 🔴 2026-10-02（重叠修复）：同 provision —— 此前**只做了 x** ⇒ 本列从 y=0 起 ⇒ TitleRow 撞骨架自己的 LayerTitle（实测 pos=(109,51) ⟷ (14,49)）。DD name_pos y 122 ⇒ 122/1080 = 0.1130 ✓
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_vertical = 3   ; 🔴 2026-10-02（塌陷修复）：同 provision —— 根撑开后本列才拿得到全高（否则 TitleRow/BodyRow 都挤在顶部）✓
