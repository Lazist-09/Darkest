; DD 1:1 heirloom_exchange（传家宝兑换）
; ── 面板尺寸：DD 布局文件未给 size；取自面板自身资产
;    campaign/town/heirloom_exchange/heirloom_exchange.background.png = 429x268
;    佐证：title_pos 215,24 的 x=215 恰为 429/2（标题正中）；全部 offset 落在 429x268 内
; ── 坐标空间：429x268 局部空间（from/to 两列各以自己 heirloom_from_pos / heirloom_to_pos 0,0 为原点）
; ── 结构（对应 DD section）：
;    heirloom_exchange_layout              根，title_pos 215,24
;    heirloom_exchange_heirloom_from_layout  转入列，choice_start_offset 79,110 / spacing 44，图标 icon_offset 0,32
;    heirloom_exchange_heirloom_to_layout    转出列，choice_start_offset 256,75 / spacing 0,44，箭头 arrow_offset 148,80
[node name="HeirloomExchangeSkeleton" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme = ExtResource("1_theme")
script = ExtResource("2_hx")

; ── 面板本体：429x268 居中承载（DD 未给屏幕级 pos，此处仅承载尺寸，不猜屏幕位置）
[node name="PanelFrame" type="Control" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -214.5
offset_top = -134.0
offset_right = 214.5
offset_bottom = 134.0
grow_horizontal = 2
grow_vertical = 2
; 🔴 2026-09-20：同上 —— 挂进容器时锚点失效 ⇒ 显式最小尺寸保住 429×268 ✓
custom_minimum_size = Vector2(429, 268)
mouse_filter = 2

; 面板背景占位（尺寸 = DD heirloom_exchange.background.png 429x268 · 资产未接入 ⇒ 色块占位，不换不删）
