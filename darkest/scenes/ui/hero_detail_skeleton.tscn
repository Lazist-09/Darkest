[ext_resource type="Script" path="res://scripts/ui/HeroDetailSkeleton.cs" id="2_hero"]

; 🔴 基准更正（E 盘辨明）：本屏服务**城池角色面板** ⇒ 基准 = town.layout character_panel_size **1395×1080**，
;   比例取自 shared/character/character.layout.darkest [character_layout]：campaign_status 93,117 ⇒ 0.0667/0.1083 ·
;   base_stats 141,358 ⇒ 0.1011/0.3315 · equipment 141,516 ⇒ 0.1011/0.4778（**DD 无独立 trinket 位 ⇒ 饰品在 equipment 区内**）
; DD 1:1 3-2：英雄面板骨架（编辑器可见可改）；比例与 DD shared\hero\hero.layout.darkest 同源
[node name="HeroDetailSkeleton" type="Control"]
script = ExtResource("2_hero")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme = ExtResource("1_theme")


