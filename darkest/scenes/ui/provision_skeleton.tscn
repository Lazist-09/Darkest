[ext_resource type="Theme" path="res://resources/theme/dd_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/ProvisionSkeleton.cs" id="2_prov"]

; DD 1:1 provision（供应）：左=队伍格 / 右=商店格 / 右上信息区；比例来自 provision.layout.darkest（x0.667）
[node name="ProvisionSkeleton" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_vertical = 3
mouse_filter = 2
theme = ExtResource("1_theme")
script = ExtResource("2_prov")


[node name="LayerTitle" type="Label" parent="."]   ; 🔴 2026-10-02：同 hamlet_skeleton —— 相对 parent 相对【场景根】解析；`ProvisionSkeleton` 会找不到 ⇒ 兜到根下改名并报加载警告；`. ` = 根的直接子节点（几何零变化）
layout_mode = 0
anchor_left = 0.004
anchor_top = 0.004
anchor_right = 0.16
anchor_bottom = 0.024
mouse_filter = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.85, 0.7, 0.36, 0.9)
text = "L2 二级面板 · 补给（provision）"
[node name="ProvisionCol" type="VBoxContainer" parent="."]
anchor_left = 0.0542   ; P5：DD provision name_pos 104,126 ⇒ x 104/1920
anchor_top = 0.1167    ; P5：DD provision name_pos 104,126 ⇒ y 126/1080（补：此前只做了 x ⇒ TitleRow 与 LayerTitle 撞）
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="ProvisionCol"]
layout_mode = 2

[node name="ProvisionTitle" type="Label" parent="ProvisionCol/TitleRow"]
layout_mode = 2
