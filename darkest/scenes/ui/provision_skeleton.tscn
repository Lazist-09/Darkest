[node name="BodyRow" type="HBoxContainer" parent="ProvisionCol"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="PartyGrid" type="GridContainer" parent="ProvisionCol/BodyRow"]
layout_mode = 2
size_flags_horizontal = 0   ; 🔴 2026-10-02：队伍格**不参与**横向扩展 —— 否则 8 列会被拉成 227 宽（格宽应为 DD 的 34）✓
columns = 8   ; 🔴 2026-10-02：party grid = 8 列（start_pos 60,28 · offset 80,160）；此前误标 2 ✓
; 出处（一手布局，仅注释溯源）：DD provision.layout.darkest party grid —— B6 门禁要求 .darkest 只出现在**整行注释**里 ✓
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="InfoCol" type="VBoxContainer" parent="ProvisionCol/BodyRow"]
layout_mode = 2
size_flags_horizontal = 0   ; 🔴 2026-10-02（重叠修复）：默认 Fill ⇒ 被 BodyRow 撑到 587 宽，长句 Label 右边界压进商店位（x≥814）⇒ 与 StoreGrid 判据 1 重叠。改 Shrink(0) + 下方 custom_minimum_size(180) ⇒ 宽 = 180（右边界 375+180=555 < 814；队伍满 8 人时 458+180=638 < 814 仍安全）✓
custom_minimum_size = Vector2(180, 0)
theme_override_constants/separation = 6

[node name="QuestInfo" type="Label" parent="ProvisionCol/BodyRow/InfoCol"]
layout_mode = 2
autowrap_mode = 2
text = "任务信息"

[node name="ScoutingStat" type="Label" parent="ProvisionCol/BodyRow/InfoCol"]
layout_mode = 2
autowrap_mode = 2   ; 🔴 2026-10-02（重叠修复）：不换行 ⇒ Label 最小宽 = 整句宽（~390）⇒ 会把 InfoCol 的 Shrink 宽度顶到 390（右边界 765，距商店位 814 只剩 49）⇒ 改为换行，让最小宽回到 1 ✓
text = "侦察数值"

[node name="SellBackInfo" type="Label" parent="ProvisionCol/BodyRow/InfoCol"]
layout_mode = 2
autowrap_mode = 2
text = "售回信息"

