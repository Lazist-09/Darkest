[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/BuildingPopupSkeleton.cs" id="1_bp"]
[ext_resource type="Theme" path="res://resources/theme/dd_theme.tres" id="9_theme"]

; ============================================================================
; building_popup —— DD 建筑弹窗（1:1 结构还原）
; ============================================================================
; 坐标空间（实测实证，见 doc/UI_STRUCTURE_DECISIONS.md §5.2）：
;   面板整体 = 662 x 764  ← E盘 campaign/town/buildings/blgupgradebg.png 实测
;   building_base_layout 的 name_pos(104,126) / body_base_pos(596,102) /
;   upgrade_base_pos(172,259) 三者均落在 662x764 内且分布合理（左列/右列/中下）
;   ⇒ 本面板所有 *.darkest 锚点 = 662x764 局部像素空间，原点左上
;   ⇒ close_pos(1496,144) 超出 662 ⇒ 属屏幕空间 1920x1080，不在本面板内
;
; 尺寸来源优先级：布局自带 size > 尺寸表参数 > 资产 PNG 固有尺寸（兜底）
;   blgupgradebg.png              662 x 764  → 面板外框
;   blg_name_background.png       208 x 224  → 名称底
;   blg_townupgrade_costframe.png 103 x 139  → 花费框
;
; 合规口径（红线27 学构图不抄素材）：只取尺寸数字与锚点构图，不使用像素
; 占位色块 UiPalette.PlaceholderFill = Color(0.62,0.6,0.58,0.22)，数据接入前不换不删
; ============================================================================

[node name="BuildingPopupBody" type="Control"]
; 面板顶容器：承载 662x764 坐标空间（居中于屏幕，便于编辑器查看）
theme = ExtResource("9_theme")
script = ExtResource("1_bp")
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -331.0
offset_top = -382.0
offset_right = 331.0
offset_bottom = 382.0
; 🔴 2026-09-20：挂进 `VBoxContainer`(body) 时**容器会忽略锚点与 offsets** ⇒ 必须显式给最小尺寸，
;    否则整块塌成 0×0（这就是"骨架错挂"的直接后果）。给了它 ⇒ 容器内仍能保持 662×764 ✓
custom_minimum_size = Vector2(662, 764)
mouse_filter = 2

[node name="PanelFrame" type="Control" parent="."]
; DD building_base_layout 容器 · 662x764 局部坐标空间承载（原点左上）
; clip_contents：800x200 活动条目 / 1000x160 坟场条目 / 720x600 坟场列表均宽于面板 ⇒ DD 行为=被面板裁剪
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
clip_contents = true
mouse_filter = 2

[node name="PanelBackground" type="ColorRect" parent="PanelFrame"]
; 面板外框 · blgupgradebg.png 662x764（尺寸=资产实测，色块占位）
color = Color(0.62, 0.6, 0.58, 0.22)
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
tooltip_text = "建筑弹窗外框 662x764（DD blgupgradebg.png 实测尺寸） · 数据未接入 ⇒ 色块占位，不换不删"

[node name="PanelSizeLabel" type="Label" parent="PanelFrame"]
layout_mode = 0
offset_left = 6.0
offset_top = 4.0
offset_right = 260.0
offset_bottom = 22.0
mouse_filter = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.85, 0.7, 0.36, 0.9)
text = "L2 建筑弹窗 · 662x764"

