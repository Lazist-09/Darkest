.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# 🔴 参考真机（DD 安装目录的副本/缓存）——**绝不入库**：
#    实测踩过：`git add -A` 把 ~2.8 GB 的 Steam depot 缓存（*.csd/*.csm）提交进来（已回滚）
#    ⇒ 参考只读，不进版本库（版权 + 体积）
Example/
Example/**
**/Darkest Dungeon/
*.csd
*.csm
*.depotcache_*


tools/__pycache__/
tools/dsh/__pycache__/

# 🔴 借用占位素材（Steam Workshop mod，无授权）—— 绝不进仓库
# 依据：doc/modules/hero_assets.md（英雄资产接口）· assets_credits.md A1 · 红线 27
borrow/
# 借用占位的落点（永不用正式资产）—— 也不进仓库
darkest/assets/heroes_placeholder/

# 🔴 大留档不入库（架构 O-90：与 2.8GB 事故同族）—— reports/ 只入库【摘要与文档】：
reports/*.txt
!reports/*_summary_*.txt
reports/*.log

# 🆕 reports 卫生（#405）：latest/ 与 archive/ 是【派生副本/归档】⇒ 不入库（只入库摘要与文档 ✓）
reports/latest/
# 🔴🔴 2026-09-26 修正（架构 O-103 · 策划 #480 指出）：原写 `reports/archive/` 整目录忽略 ⇒
#   架构 9 个窗口备份全被忽略 ⇒ 只在本机 ⇒ 换机/clone/误删即全没（"固化"其实是"降一级的易失"）。
#   ⚠️ Git 规则：**父目录被整体排除时，无法用 `!` 重新包含其中的文件** ——
#      所以这里【不能写 `reports/archive/`】，只能写成"排除内容 + 放行窗口文本"。
#   判据："这个留存面，`git ls-files` 能列出它吗？" —— 列不出 ⇒ 它不叫留存面。
#   例外范围：`TXT_*`（窗口文本，体积可控，单档 ~600KB）；其余派生副本继续忽略（红线 O-90 不变）。
reports/archive/**
!reports/archive/TXT_*.txt

# test/smoke run products (architect 2026-09-18: they kept polluting git status,
# and "clean worktree" is the precondition for the pre-commit check)
darkest/.tmp_appdata/
darkest/Godot/
